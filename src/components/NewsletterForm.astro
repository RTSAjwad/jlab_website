---
// Newsletter sign-up placeholder.
// The newsletter backend is a future feature; until then the form is disabled
// with a clear message.
---

<form class="newsletter-form" onsubmit="return false;">
	<div class="fields">
		<div class="field">
			<label for="newsletter-name">First name or full name</label>
			<input id="newsletter-name" name="name" type="text" disabled />
		</div>
		<div class="field">
			<label for="newsletter-email">Email</label>
			<input id="newsletter-email" name="email" type="email" disabled />
		</div>
	</div>
	<button type="submit" class="sl-link-button primary" disabled>Subscribe</button>
</form>

<style>
	.newsletter-form {
		display: grid;
		gap: 1rem;
		max-width: 24rem;
		margin-top: 1rem;
	}
	.fields {
		display: grid;
		gap: 0.75rem;
	}
	.field {
		display: grid;
		gap: 0.375rem;
	}
	.field label {
		font-size: var(--sl-text-sm);
		font-weight: 500;
	}
	.field input {
		width: 100%;
		padding: 0.5rem 0.75rem;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		color: var(--sl-color-text);
		font: inherit;
	}
	.field input:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
</style>
